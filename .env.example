# LifeForge works fully without any environment variable (the game is 100% local).
# Everything below is optional. NEVER commit real values: copy this file to
# .env.local for local development (it is git-ignored) and set production values
# in Vercel → Project → Settings → Environment Variables.

# --- Gemini AI (optional, server-side only) ---------------------------------
# Used ONLY by the serverless functions in /api (never bundled into the app).
# Use a Gemini API key from a Google AI Studio Free Tier project.
# Do not enable paid billing if you want to keep this at €0.
GEMINI_API_KEY=

# Optional model override. Empty = gemini-flash-latest (Google's alias for the
# current Flash model, multimodal and available on the Free Tier).
GEMINI_MODEL=

# --- Web Push (optional) ---------------------------------------------------
# Without these, reminders are shown only while the app is open (in-app +
# service-worker notifications). With them, the app registers a push
# subscription and sends the next 24 h of reminder times to your backend.
# See README.md → "Push notifications" for the backend contract.

# VAPID public key (URL-safe base64), generated with e.g. `npx web-push generate-vapid-keys`
VITE_PUSH_PUBLIC_KEY=

# Base URL of your push backend. The app calls POST {endpoint}/subscribe,
# POST {endpoint}/unsubscribe and POST {endpoint}/schedule.
VITE_PUSH_ENDPOINT=
