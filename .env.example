# LifeForge runs 100% locally with no environment variables.
# Everything below is optional.

# --- Web Push (optional) ---------------------------------------------------
# Without these, reminders are shown only while the app is open (in-app +
# service-worker notifications). With them, the app registers a push
# subscription and sends the next 24 h of reminder times to your backend.
# See README.md → "Push notifications" for the backend contract.

# VAPID public key (URL-safe base64), generated with e.g. `npx web-push generate-vapid-keys`
VITE_PUSH_PUBLIC_KEY=

# Base URL of your push backend. The app calls POST {endpoint}/subscribe,
# POST {endpoint}/unsubscribe and POST {endpoint}/schedule.
VITE_PUSH_ENDPOINT=
