{
  "name": "lifeforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LIFEFORGE — a personal life tycoon / RPG. Your real life is the game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
